---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import BackToTop from "../components/BackToTop.astro";
import avatar from "../assets/avatar.webp";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const isProd = import.meta.env.PROD;
const { frontmatter } = Astro.props;
const imageUrl = new URL(avatar.src, Astro.site).href;

const date = frontmatter.date ? new Date(frontmatter.date) : null;
const formattedDate = date?.toLocaleDateString(lang, {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "Asia/Tokyo",
});
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <title>{frontmatter.title}</title>
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="icysamon" />
    <meta property="og:title" content={frontmatter.title} />
    <meta property="og:image" content={imageUrl} />
    {isProd && <GoogleAnalytics />}
  </head>

  <body class="flex min-h-dvh flex-col bg-white dark:bg-[#242327]">
    <Header />
    <div class="mx-auto w-full max-w-200 px-4 py-8 sm:px-6 lg:px-8">
      <!-- Header -->
      <header class="border-b border-gray-200 pb-6 dark:border-white/20">
        <h1
          class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white"
        >
          {frontmatter.title}
        </h1>

        <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">
          {frontmatter.description}
        </p>

        {
          date && (
            <time
              datetime={date.toISOString()}
              class="mt-1.5 block text-sm text-gray-500 dark:text-gray-400"
            >
              {formattedDate}
            </time>
          )
        }
      </header>

      <!-- Markdownコンテンツが挿入される -->
      <main
        class="prose mt-8 max-w-none dark:prose-invert prose-table:border-separate prose-table:border-spacing-0 prose-table:overflow-hidden prose-table:rounded-md prose-table:bg-slate-500/5 dark:prose-table:bg-white/5 prose-thead:border-0 prose-thead:bg-slate-500/10 dark:prose-thead:bg-white/10 prose-tr:border-0 prose-th:px-4 prose-th:py-2.5 prose-td:px-4 prose-td:py-2.5 [&_tbody_tr+tr_td]:border-t-2 [&_tbody_tr+tr_td]:border-white dark:[&_tbody_tr+tr_td]:border-[#242327] [&_thead:not(:has(th:not(:empty)))]:hidden"
      >
        <slot />
      </main>

      <!-- Back link (HyperUI: Text Button) -->
      <footer class="mt-12">
        <a
          href={translatePath("/")}
          class="inline-block rounded-sm border border-indigo-600 px-8 py-3 text-sm font-medium text-indigo-600 transition-colors hover:bg-indigo-600 hover:text-white focus:ring-3 focus:outline-hidden dark:border-indigo-400 dark:text-indigo-400 dark:hover:bg-indigo-400 dark:hover:text-gray-900"
        >
          {t("back")}
        </a>
      </footer>
    </div>

    <div class="mx-auto mt-auto w-full max-w-200 px-4 sm:px-6 lg:px-8">
      <Footer />
    </div>
    <BackToTop />
  </body>
</html>

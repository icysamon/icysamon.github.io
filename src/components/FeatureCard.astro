---
interface Props {
  title: string;
  description: string;
  image: string;
  href: string;
}

const { title, description, image, href } = Astro.props;
---

<a
  href={href}
  class="group relative block h-72 w-full max-w-2xl overflow-hidden rounded-md"
>
  <!-- Inset 1px so the panel alone reaches the rounded edge; otherwise the image bleeds through the panel's anti-aliased corners -->
  <img
    alt=""
    src={image}
    class="absolute inset-px size-[calc(100%-2px)] rounded-[calc(var(--radius-md)-1px)] object-cover"
  />

  <!-- 1/5 of the card, but never narrower than "Work" plus the card padding on both sides (centered on phones). Profile card panel color (page bg + slate-500/5, white/5 in dark); expands over the whole card on hover -->
  <div
    class="absolute inset-y-0 left-0 w-20 bg-[#fafafb]/95 sm:w-[max(20%,6rem)] lg:w-[max(20%,7rem)] transition-[width] duration-500 ease-[cubic-bezier(0.2,0,0,1)] group-hover:w-full motion-reduce:transition-none dark:bg-[#2f2e32]/95"
  >
  </div>

  <div class="relative flex h-full flex-col p-4 sm:p-6 lg:p-8">
    <p class="text-sm font-medium tracking-widest text-pink-600 uppercase">
      Work
    </p>

    <div
      class="relative -ml-4 mt-2 w-fit max-w-[calc(100%+1rem)] py-2 pr-4 pl-4 sm:-ml-6 sm:max-w-[calc(100%+1.5rem)] sm:pr-5 sm:pl-6 lg:-ml-8 lg:max-w-[calc(100%+2rem)] lg:pl-8"
    >
      <!-- Solid band from the card edge to just past the title; slides off to the left on hover -->
      <span
        aria-hidden="true"
        class="absolute inset-0 bg-[#e8e9ec]/95 transition-[translate,opacity] duration-500 ease-[cubic-bezier(0.2,0,0,1)] group-hover:-translate-x-full group-hover:opacity-0 motion-reduce:transition-none dark:bg-[#3a393d]/95"
      ></span>

      <p
        class="relative text-xl font-bold text-gray-900 sm:text-2xl dark:text-gray-50"
      >
        {title}
      </p>
    </div>

    <div class="mt-auto">
      <div
        class="translate-y-8 transform opacity-0 transition-all group-hover:translate-y-0 group-hover:opacity-100"
      >
        <p class="text-sm text-gray-700 dark:text-gray-300">
          {description}
        </p>
      </div>
    </div>
  </div>
</a>

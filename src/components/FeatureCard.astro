---
interface Props {
  title: string;
  description: string;
  image: string;
  href: string;
}

const { title, description, image, href } = Astro.props;
---

<a
  href={href}
  class="group relative block bg-black w-full max-w-2xl h-72 overflow-hidden rounded-md"
>
  <img
    alt=""
    src={image}
    class="absolute inset-0 h-full w-full object-cover opacity-90 transition-opacity group-hover:opacity-50 rounded-md"
  />

  <div class="relative flex flex-col h-full p-4 sm:p-6 lg:p-8">
    <p class="text-sm font-medium tracking-widest text-pink-600 uppercase">
      Work
    </p>

    <p class="text-xl font-bold text-white sm:text-2xl">{title}</p>

    <div class="mt-auto">
      <div
        class="translate-y-8 transform opacity-0 transition-all group-hover:translate-y-0 group-hover:opacity-100"
      >
        <p class="text-sm text-white">
          {description}
        </p>
      </div>
    </div>
  </div>
</a>

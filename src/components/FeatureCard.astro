---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  href: string;
}

const { title, description, image, href } = Astro.props;
---

<!-- Same layout as the blog's featured post card (blog.icysamon.com): image on top on phones, image 3fr / text 2fr from sm, 288px tall -->
<a
  href={href}
  class="group grid w-full grid-cols-1 overflow-hidden rounded-md bg-slate-500/5 transition-colors duration-150 hover:bg-slate-500/10 sm:min-h-72 sm:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] dark:bg-white/5 dark:hover:bg-white/10"
>
  <div
    class="relative aspect-video overflow-hidden bg-slate-500/10 sm:aspect-auto dark:bg-white/10"
  >
    <!-- Card is at most 672px wide (90vw on phones); the image takes 3/5 of it from sm -->
    <Image
      alt=""
      src={image}
      width={672}
      widths={[400, 672, 960, 1344]}
      sizes="(min-width: 640px) min(54vw, 404px), min(90vw, 42rem)"
      loading="eager"
      class="absolute inset-0 size-full object-cover transition-[scale] duration-500 ease-[cubic-bezier(0.2,0,0,1)] group-hover:scale-105 motion-reduce:transition-none"
    />
  </div>

  <div class="flex flex-col justify-center gap-2 p-5 sm:p-6">
    <p
      class="text-xs font-medium tracking-[0.1em] text-pink-600 uppercase dark:text-pink-400"
    >
      Work
    </p>
    <p class="text-2xl/8 font-bold text-gray-900 dark:text-gray-50">
      {title}
    </p>
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
      {description}
    </p>
  </div>
</a>

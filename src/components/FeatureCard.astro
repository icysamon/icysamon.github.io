---
interface Props {
  title: string;
  description: string;
  image: string;
  href: string;
}

const { title, description, image, href } = Astro.props;
---

<a
  href={href}
  class="group relative block h-72 w-full max-w-2xl overflow-hidden rounded-md bg-black"
>
  <img
    alt=""
    src={image}
    class="absolute inset-0 h-full w-full rounded-md object-cover"
  />

  <!-- 1/5 of the card, but never narrower than "Work" plus the card padding on both sides (centered on phones). Profile card panel color (page bg + slate-500/5, white/5 in dark); expands over the whole card on hover -->
  <div
    class="absolute inset-y-0 left-0 w-20 bg-[#fafafb]/95 sm:w-[max(20%,6rem)] lg:w-[max(20%,7rem)] transition-[width] duration-500 ease-[cubic-bezier(0.2,0,0,1)] group-hover:w-full motion-reduce:transition-none dark:bg-[#2f2e32]/95"
  >
  </div>

  <div class="relative flex h-full flex-col p-4 sm:p-6 lg:p-8">
    <p class="text-sm font-medium tracking-widest text-pink-600 uppercase">
      Work
    </p>

    <div
      class="relative -mx-4 mt-2 px-4 py-2 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8"
    >
      <!-- Table header color (page bg + slate-500/10, white/10 in dark) fading out to the right; slides off to the left on hover -->
      <span
        aria-hidden="true"
        class="absolute inset-y-0 left-0 w-1/2 bg-linear-to-r from-[#f0f1f3]/80 to-transparent transition-[translate,opacity] duration-500 ease-[cubic-bezier(0.2,0,0,1)] group-hover:-translate-x-full group-hover:opacity-0 motion-reduce:transition-none dark:from-[#3a393d]/80"
      ></span>

      <p
        class="relative text-xl font-bold text-gray-900 sm:text-2xl dark:text-gray-50"
      >
        {title}
      </p>
    </div>

    <div class="mt-auto">
      <div
        class="translate-y-8 transform opacity-0 transition-all group-hover:translate-y-0 group-hover:opacity-100"
      >
        <p class="text-sm text-gray-700 dark:text-gray-300">
          {description}
        </p>
      </div>
    </div>
  </div>
</a>

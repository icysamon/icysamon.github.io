---
import avatar from "../assets/avatar.webp";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="flex w-full flex-col items-center">
  <div class="aspect-square w-full overflow-hidden rounded-t-md">
    <img
      alt=""
      src={avatar.src}
      class="avatar size-full object-cover transition-[scale] duration-500 ease-[cubic-bezier(0.2,0,0,1)] hover:scale-105 motion-reduce:animate-none motion-reduce:transition-none"
    />
  </div>
  <div class="mt-4 px-6 text-center">
    <h3 class="text-gray-900 sm:text-xl dark:text-gray-50">
      {t("profile.name")}
    </h3>
    <p class="mt-0.5 text-gray-700 dark:text-gray-300">
      {t("profile.description")}
    </p>
  </div>
</div>

<style>
  .avatar {
    animation: avatar-settle 1.2s cubic-bezier(0.2, 0, 0, 1) backwards;
  }

  @keyframes avatar-settle {
    from {
      scale: 1.6;
    }
  }
</style>

---
import avatar from "../assets/avatar.webp";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="flex w-full flex-col items-center">
  <div class="aspect-square w-full overflow-hidden rounded-t-md">
    <img
      alt={t("profile.name")}
      src={avatar.src}
      class="avatar size-full object-cover transition-[scale] duration-500 ease-[cubic-bezier(0.2,0,0,1)] data-ready:hover:scale-105 motion-reduce:animate-none motion-reduce:transition-none"
    />
  </div>
  <div class="mt-4 px-6 text-center">
    <h3 class="text-gray-900 sm:text-xl dark:text-gray-50">
      {t("profile.name")}
    </h3>
    <p class="mt-0.5 text-gray-700 dark:text-gray-300">
      {t("profile.description")}
    </p>
  </div>
</div>

<script>
  // Enable the hover zoom only after the entrance animation, so an early hover can't cut it short
  document.querySelectorAll<HTMLElement>(".avatar").forEach((avatar) => {
    const ready = () => (avatar.dataset.ready = "");
    if (avatar.getAnimations().length === 0) ready();
    else avatar.addEventListener("animationend", ready, { once: true });
  });
</script>

<style>
  .avatar {
    animation: avatar-settle 1.2s cubic-bezier(0.2, 0, 0, 1) backwards;
  }

  @keyframes avatar-settle {
    from {
      scale: 1.6;
    }
  }
</style>

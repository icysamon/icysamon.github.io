---
import avatar from "../assets/avatar.webp";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="flex items-center gap-4 mx-4 mr-8 max-w-3xl">
  <img alt="" src={avatar.src} class="size-28 rounded-full" />
  <div>
    <h3 class="text-gray-900 dark:text-gray-50 sm:text-xl">
      {t("profile.name")}
    </h3>
    <p class="mt-0.5 text-gray-700 dark:text-gray-300 max-w-64">
      {t("profile.description")}
    </p>
  </div>
</div>

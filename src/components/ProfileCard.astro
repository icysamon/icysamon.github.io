---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.webp";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<!-- Same size as the blog's profile panel (blog.icysamon.com), so the sidebar doesn't shift when moving between the sites -->
<div
  class="flex w-full flex-col overflow-hidden rounded-md bg-slate-500/5 dark:bg-white/5"
>
  <div class="aspect-square w-full overflow-hidden">
    <!-- md:w-80 sidebar from md; below that the card fills the 90%-wide main, up to max-w-2xl -->
    <Image
      alt={t("profile.name")}
      src={avatar}
      width={640}
      widths={[320, 480, 640, 960, 1344]}
      sizes="(min-width: 768px) 320px, min(90vw, 42rem)"
      loading="eager"
      fetchpriority="high"
      class="avatar size-full object-cover transition-[scale] duration-500 ease-[cubic-bezier(0.2,0,0,1)] data-ready:hover:scale-105 motion-reduce:animate-none motion-reduce:transition-none"
    />
  </div>
  <div class="flex flex-col items-center gap-1 p-5 text-center">
    <h3 class="text-lg/7 font-bold text-gray-900 dark:text-gray-50">
      {t("profile.name")}
    </h3>
    <!-- Same font stack and smoothing as the blog's headline, so the glyphs render at the same weight -->
    <p
      class="font-[ui-sans-serif,system-ui,-apple-system,'Hiragino_Sans','Noto_Sans_JP','Yu_Gothic_UI',Meiryo,sans-serif] text-2xl/8 text-gray-600 antialiased dark:text-gray-300"
    >
      {t("profile.description")}
    </p>
    <slot />
  </div>
</div>

<script>
  // Enable the hover zoom only after the entrance animation, so an early hover can't cut it short
  document.querySelectorAll<HTMLElement>(".avatar").forEach((avatar) => {
    const ready = () => (avatar.dataset.ready = "");
    if (avatar.getAnimations().length === 0) ready();
    else avatar.addEventListener("animationend", ready, { once: true });
  });
</script>

<style>
  .avatar {
    animation: avatar-settle 1.2s cubic-bezier(0.2, 0, 0, 1) backwards;
  }

  @keyframes avatar-settle {
    from {
      scale: 1.6;
    }
  }
</style>

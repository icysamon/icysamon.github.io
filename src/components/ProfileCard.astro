---
import avatar from "../assets/avatar.webp";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="flex items-center gap-4 mx-4 mr-8 max-w-3xl">
  <img
    alt=""
    src={avatar.src}
    class="size-28 rounded-[50%] transition-[border-radius,scale,rotate] duration-500 ease-[cubic-bezier(0.2,0,0,1)] hover:rounded-[30%] hover:scale-105 hover:-rotate-6 motion-reduce:transition-none"
  />
  <div>
    <h3 class="text-gray-900 dark:text-gray-50 sm:text-xl">
      {t("profile.name")}
    </h3>
    <p class="mt-0.5 text-gray-700 dark:text-gray-300 max-w-64">
      {t("profile.description")}
    </p>
  </div>
</div>

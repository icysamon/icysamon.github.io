---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  date: string;
  href: string;
  image: ImageMetadata;
  imageAlt: string;
}
import { getLangFromUrl } from "../i18n/utils";

const { title, description, date, href, image, imageAlt } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const localeMap = { en: "en-US", ja: "ja-JP" } as const;
const formattedDate = new Date(date).toLocaleDateString(localeMap[lang], {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<article
  class="max-w-lg overflow-hidden rounded-md bg-slate-500/5 dark:bg-white/5"
>
  <a href={href} class="block overflow-hidden">
    <!-- Column width of the grid: 1 column (max-w-lg), 2 from sm, 3 from lg, inside max-w-7xl minus px-6 and the gaps -->
    <Image
      alt={imageAlt}
      src={image}
      width={600}
      widths={[400, 600, 800, 1024]}
      sizes="(min-width: 1280px) 390px, (min-width: 1024px) calc((100vw - 112px) / 3), (min-width: 640px) calc((100vw - 80px) / 2), min(calc(100vw - 48px), 32rem)"
      loading="eager"
      class="h-56 w-full object-cover transition-[scale] duration-500 ease-[cubic-bezier(0.2,0,0,1)] hover:scale-105 motion-reduce:transition-none sm:h-48 lg:h-64"
    />
  </a>

  <div class="p-4 sm:p-6">
    <time
      datetime={date}
      class="block text-xs text-gray-500 dark:text-gray-400"
    >
      {formattedDate}
    </time>

    <a href={href}>
      <h3 class="mt-0.5 text-lg text-pink-600 hover:underline">
        {title}
      </h3>
    </a>

    <p
      class="mt-2 line-clamp-3 text-sm/relaxed text-gray-700 dark:text-gray-300"
    >
      {description}
    </p>
  </div>
</article>

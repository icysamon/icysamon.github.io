---
interface Props {
  title: string;
  description: string;
  date: string;
  href: string;
  image: any;
  imageAlt: string;
}
import { getLangFromUrl } from "../i18n/utils";

const { title, description, date, href, image, imageAlt } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const localeMap = { en: "en-US", ja: "ja-JP" } as const;
const formattedDate = new Date(date).toLocaleDateString(localeMap[lang], {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<article
  class="max-w-lg overflow-hidden rounded-md bg-slate-500/5 dark:bg-white/5"
>
  <a href={href} class="block overflow-hidden">
    <img
      alt={imageAlt}
      src={image}
      class="h-56 w-full object-cover transition-[scale] duration-500 ease-[cubic-bezier(0.2,0,0,1)] hover:scale-105 motion-reduce:transition-none sm:h-48 lg:h-64"
    />
  </a>

  <div class="p-4 sm:p-6">
    <time
      datetime={date}
      class="block text-xs text-gray-500 dark:text-gray-400"
    >
      {formattedDate}
    </time>

    <a href={href}>
      <h3 class="mt-0.5 text-lg text-pink-600 hover:underline">
        {title}
      </h3>
    </a>

    <p
      class="mt-2 line-clamp-3 text-sm/relaxed text-gray-700 dark:text-gray-300"
    >
      {description}
    </p>
  </div>
</article>

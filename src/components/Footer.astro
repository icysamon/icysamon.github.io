---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div
  class="flex flex-col mx-auto mt-8 mb-4 py-4 text-xs max-w-7xl text-gray-500 dark:text-gray-400 text-center gap-1.5 border-t border-gray-200 dark:border-gray-700"
>
  <a href={translatePath("/privacy-policy")} class="hover:underline">
    {t("dictionary.privacyPolicy")}
  </a>
  <p>
    &copy; {new Date().getFullYear()} icysamon. All rights reserved.
  </p>
</div>

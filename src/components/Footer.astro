---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div
  class="mx-auto mt-8 mb-4 flex max-w-7xl flex-col gap-1.5 border-t border-gray-200 py-4 text-center text-xs text-gray-500 dark:border-white/20 dark:text-gray-400"
>
  <a href={translatePath("/privacy-policy")} class="self-center hover:underline">
    {t("dictionary.privacyPolicy")}
  </a>
  <p>
    &copy; {new Date().getFullYear()} icysamon. All rights reserved.
  </p>
</div>

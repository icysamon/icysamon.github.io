---
// Card.astro
interface Props {
  title: string;
  subtitle?: string;
  href?: string;
  color?: string;
  image?: string;
  width?: string;
  height?: string;
}

const {
  title,
  subtitle,
  href,
  color = "#6eee87",
  image,
  width = "320px",
  height = "320px",
} = Astro.props;

const Tag = href ? "a" : "div";
---

<Tag
  class="card"
  href={href}
  style={`--card-width: ${width}; --card-height: ${height}; --card-color: ${color};`}
>
  <div
    class="card-img"
    style={image ? `background-image: url(${image});` : undefined}
  >
  </div>
  <div class="card-info">
    <div class="card-text">
      <p class="text-title">{title}</p>
      {subtitle && <p class="text-subtitle">{subtitle}</p>}
    </div>
    <div class="card-icon">
      <svg viewBox="0 0 28 25" class="icon">
        <path
          d="M13.145 2.13l1.94-1.867 12.178 12-12.178 12-1.94-1.867 8.931-8.8H.737V10.93h21.339z"
        ></path>
      </svg>
    </div>
  </div>
</Tag>

<style>
  .card {
    display: block;
    width: var(--card-width);
    height: var(--card-height);
    position: relative;
    border-radius: 16px;
    background: #f5f5f5;
    transition: box-shadow 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
  }

  .card-img {
    position: absolute;
    height: 100%;
    width: 100%;
    background-color: var(--card-color);
    background-size: cover;
    background-position: center;
  }

  .card-info {
    position: absolute;
    width: 100%;
    bottom: 0;
    padding: 1rem;
    box-sizing: border-box;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .card-icon {
    opacity: 0;
    transform: translateX(-20%);
    width: 2em;
    height: 2em;
    transition: all 0.3s ease-in-out;
  }

  .icon {
    --size: 20px;
    width: var(--size);
    height: var(--size);
  }

  /* Text */
  .card-text p {
    margin: 0;
    line-height: 140%;
    /* 複数行にしたい場合はこの行を削除 */
    white-space: nowrap;
  }

  .text-title {
    font-weight: 900;
    font-size: 1.2rem;
    color: #222;
  }

  .text-subtitle {
    color: #333;
    font-weight: 500;
    font-size: 1rem;
  }

  /* Hover */
  .card:hover {
    box-shadow: 0 10px 20px 4px rgba(35, 35, 35, 0.1);
  }

  .card:hover .card-icon {
    opacity: 1;
    transform: translateX(20%);
  }
</style>

---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import { languages } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const pathWithoutLang =
  Astro.url.pathname.replace(new RegExp(`^/${lang}(?=/|$)`), "") || "/";
---

<header class="bg-white dark:bg-[#242327]">
  <div
    class="mx-auto flex h-16 max-w-7xl items-center gap-8 px-4 sm:px-6 lg:px-8"
  >
    <div class="flex flex-1 items-center justify-between">
      <a
        href={translatePath("/")}
        class="text-base font-bold text-gray-700 transition hover:text-gray-900 md:hidden dark:text-gray-200 dark:hover:text-white"
      >
        icysamon
      </a>
      <nav aria-label="Global" class="hidden md:block">
        <ul class="flex items-center gap-7 text-[0.9375rem] tracking-wide">
          <li>
            <a
              class="font-medium text-gray-600 transition hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
              href={translatePath("/")}
            >
              {t("nav.home")}
            </a>
          </li>

          <li>
            <a
              class="font-medium text-gray-600 transition hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
              href={translatePath("/about")}
            >
              {t("nav.about")}
            </a>
          </li>

          <li>
            <a
              class="font-medium text-gray-600 transition hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
              href={translatePath("/music")}
            >
              {t("nav.music")}
            </a>
          </li>

          <li>
            <a
              class="font-medium text-gray-600 transition hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
              href={translatePath("/electronic-work")}
            >
              {t("nav.electronicWork")}
            </a>
          </li>

          <li>
            <a
              class="font-medium text-gray-600 transition hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
              href={translatePath("/game")}
            >
              {t("nav.game")}
            </a>
          </li>
        </ul>
      </nav>

      <div class="flex items-center gap-3">
        <details id="lang-menu" class="group relative">
          <summary
            class="flex cursor-pointer list-none items-center gap-1.5 rounded-sm bg-gray-100 px-3 py-2.5 text-sm font-medium text-gray-600 transition hover:text-gray-600/75 dark:bg-[#1a191c] dark:text-gray-300 dark:hover:text-gray-300/75 [&::-webkit-details-marker]:hidden"
          >
            <span class="sr-only">Language</span>
            <svg
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              class="size-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 21a9 9 0 1 0 0-18m0 18a9 9 0 1 1 0-18m0 18c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m-8.716 6h17.432M3.284 15h17.432"
              ></path>
            </svg>
            <span>{languages[lang]}</span>
            <svg
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              class="size-4 transition group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7"
              ></path>
            </svg>
          </summary>

          <div
            role="menu"
            class="absolute end-0 z-20 mt-2 w-36 overflow-hidden rounded-sm bg-gray-100 p-1 shadow-lg dark:bg-[#1a191c]"
          >
            {
              Object.entries(languages).map(([code, label]) => (
                <a
                  role="menuitem"
                  href={translatePath(pathWithoutLang, code)}
                  hreflang={code}
                  aria-current={code === lang ? "true" : undefined}
                  class:list={[
                    "flex items-center justify-between rounded-sm px-3 py-2 text-sm transition hover:bg-white hover:text-gray-900 dark:hover:bg-[#2c2b30] dark:hover:text-white",
                    code === lang
                      ? "font-medium text-gray-900 dark:text-white"
                      : "text-gray-600 dark:text-gray-300",
                  ]}
                >
                  {label}
                  {code === lang && (
                    <svg
                      aria-hidden="true"
                      xmlns="http://www.w3.org/2000/svg"
                      class="size-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m4.5 12.75 6 6 9-13.5"
                      />
                    </svg>
                  )}
                </a>
              ))
            }
          </div>
        </details>

        <button
          id="menu-button"
        class="block rounded-sm bg-gray-100 p-2.5 text-gray-600 transition hover:text-gray-600/75 md:hidden dark:bg-[#1a191c] dark:text-gray-300"
      >
        <span class="sr-only">Toggle menu</span>
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          class="size-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- スマホ用メニュー -->
  <nav
    id="mobile-menu"
    aria-label="Mobile"
    class="fixed inset-0 z-50 hidden bg-white/90 backdrop-blur-sm md:hidden dark:bg-[#242327]/90"
  >
    <div class="flex h-16 items-center justify-end px-4 sm:px-6">
      <button
        id="menu-close"
        type="button"
        class="rounded-sm bg-gray-100 p-2.5 text-gray-600 dark:bg-[#1a191c] dark:text-gray-300"
      >
        <span class="sr-only">Close menu</span>
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          class="size-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <ul class="space-y-1 px-4 sm:px-6">
      <li>
        <a
          href={translatePath("/")}
          class="block rounded-lg px-4 py-2 text-[0.9375rem] font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-[#1a191c] dark:hover:text-white"
        >
          {t("nav.home")}
        </a>
      </li>

      <li>
        <a
          href={translatePath("/about")}
          class="block rounded-lg px-4 py-2 text-[0.9375rem] font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-[#1a191c] dark:hover:text-white"
        >
          {t("nav.about")}
        </a>
      </li>

      <li>
        <a
          href={translatePath("/music")}
          class="block rounded-lg px-4 py-2 text-[0.9375rem] font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-[#1a191c] dark:hover:text-white"
        >
          {t("nav.music")}
        </a>
      </li>

      <li>
        <a
          href={translatePath("/electronic-work")}
          class="block rounded-lg px-4 py-2 text-[0.9375rem] font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-[#1a191c] dark:hover:text-white"
        >
          {t("nav.electronicWork")}
        </a>
      </li>

      <li>
        <a
          href={translatePath("/game")}
          class="block rounded-lg px-4 py-2 text-[0.9375rem] font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-[#1a191c] dark:hover:text-white"
        >
          {t("nav.game")}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const menu = document.getElementById("mobile-menu");

    if (target.closest("#menu-button")) {
      menu?.classList.remove("hidden");
    } else if (target.closest("#menu-close")) {
      menu?.classList.add("hidden");
    }

    const langMenu = document.getElementById("lang-menu") as HTMLDetailsElement | null;
    if (langMenu?.open && !target.closest("#lang-menu")) {
      langMenu.open = false;
    }
  });
</script>

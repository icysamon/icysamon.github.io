---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<header class="bg-white dark:bg-[#242327]">
  <div
    class="mx-auto flex h-16 max-w-7xl items-center gap-8 px-4 sm:px-6 lg:px-8"
  >
    <div class="flex flex-1 items-center justify-end md:justify-between">
      <nav aria-label="Global" class="hidden md:block">
        <ul class="flex items-center gap-6 text-sm">
          <li>
            <a
              class="text-gray-500 transition dark:text-gray-100 dark:hover:text-gray-300 hover:text-gray-500/75"
              href={translatePath("/")}
            >
              {t("nav.home")}
            </a>
          </li>

          <li>
            <a
              class="text-gray-500 transition dark:text-gray-100 dark:hover:text-gray-300 hover:text-gray-500/75"
              href={translatePath("/about")}
            >
              {t("nav.about")}
            </a>
          </li>
        </ul>
      </nav>

      <button
        id="menu-button"
        class="block rounded-sm bg-gray-100 dark:bg-[#1a191c] p-2.5 text-gray-600 dark:text-gray-300 transition hover:text-gray-600/75 md:hidden"
      >
        <span class="sr-only">Toggle menu</span>
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          class="size-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- スマホ用メニュー -->
  <nav
    id="mobile-menu"
    aria-label="Mobile"
    class="hidden fixed inset-0 z-50 bg-white/90 dark:bg-[#242327]/90 backdrop-blur-sm md:hidden"
  >
    <div class="flex h-16 items-center justify-end px-4 sm:px-6">
      <button
        id="menu-close"
        type="button"
        class="rounded-sm bg-gray-100 dark:bg-[#1a191c] p-2.5 text-gray-600 dark:text-gray-300"
      >
        <span class="sr-only">Close menu</span>
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          class="size-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <ul class="space-y-1 px-4 sm:px-6">
      <li>
        <a
          href={translatePath("/")}
          class="block rounded-lg px-4 py-2 text-sm font-medium text-gray-500 dark:text-gray-100 hover:bg-gray-100 dark:hover:bg-[#1a191c] hover:text-gray-700 dark:hover:text-gray-300"
        >
          {t("nav.home")}
        </a>
      </li>
      <li>
        <a
          href={translatePath("/about")}
          class="block rounded-lg px-4 py-2 text-sm font-medium text-gray-500 dark:text-gray-100 hover:bg-gray-100 dark:hover:bg-[#1a191c] hover:text-gray-700 dark:hover:text-gray-300"
        >
          {t("nav.about")}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const menu = document.getElementById("mobile-menu");

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    if (target.closest("#menu-button")) {
      menu?.classList.remove("hidden");
    } else if (
      target.closest("#menu-close") ||
      target.closest("#mobile-menu a")
    ) {
      menu?.classList.add("hidden");
    }
  });
</script>

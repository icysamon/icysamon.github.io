---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import { languages } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const pathWithoutLang =
  Astro.url.pathname.replace(new RegExp(`^/${lang}(?=/|$)`), "") || "/";
---

<header class="bg-white dark:bg-[#242327]">
  <!-- Same container as the blog's header (blog.icysamon.com): 90% wide, max 1024px, so "icysamon" lines up with the sidebar's left edge -->
  <div class="mx-auto flex h-16 w-[90%] max-w-5xl items-center gap-8">
    <div class="flex flex-1 items-center justify-between">
      <div class="flex items-center gap-6">
        <a
          href={translatePath("/")}
          class="text-base font-bold text-gray-700 transition hover:text-gray-900 dark:text-gray-200 dark:hover:text-white"
        >
          icysamon
        </a>
        <nav aria-label="Global" class="hidden md:block">
          <ul class="flex items-center gap-7 text-[0.9375rem] tracking-wide">
            <li>
              <a
                class="font-medium text-gray-600 transition hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
                href={translatePath("/about")}
              >
                {t("nav.about")}
              </a>
            </li>

            <li>
              <a
                class="font-medium text-gray-600 transition hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
                href={translatePath("/music")}
              >
                {t("nav.music")}
              </a>
            </li>

            <li>
              <a
                class="font-medium text-gray-600 transition hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
                href={translatePath("/electronic-work")}
              >
                {t("nav.electronicWork")}
              </a>
            </li>

            <li>
              <a
                class="font-medium text-gray-600 transition hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
                href={translatePath("/game")}
              >
                {t("nav.game")}
              </a>
            </li>
          </ul>
        </nav>
      </div>

      <div class="flex items-center gap-3">
        <details id="lang-menu" class="group relative">
          <summary
            class="flex cursor-pointer list-none items-center gap-1.5 rounded-sm bg-gray-100 px-3 py-2.5 text-sm font-medium text-gray-600 transition hover:text-gray-600/75 dark:bg-[#1a191c] dark:text-gray-300 dark:hover:text-gray-300/75 [&::-webkit-details-marker]:hidden"
          >
            <span class="sr-only">Language</span>
            <svg
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              class="size-4 translate-y-[0.05px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 21a9 9 0 1 0 0-18m0 18a9 9 0 1 1 0-18m0 18c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m-8.716 6h17.432M3.284 15h17.432"
              ></path>
            </svg>
            <span>{languages[lang]}</span>
            <svg
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              class="size-4 transition group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7"
              ></path>
            </svg>
          </summary>

          <div
            role="menu"
            class="absolute end-0 z-20 mt-2 w-36 overflow-hidden rounded-sm bg-gray-100 p-1 shadow-lg dark:bg-[#1a191c]"
          >
            {
              Object.entries(languages).map(([code, label]) => (
                <a
                  role="menuitem"
                  href={translatePath(pathWithoutLang, code)}
                  hreflang={code}
                  aria-current={code === lang ? "true" : undefined}
                  class:list={[
                    "flex items-center justify-between rounded-sm px-3 py-2 text-sm transition hover:bg-white hover:text-gray-900 dark:hover:bg-[#2c2b30] dark:hover:text-white",
                    code === lang
                      ? "font-medium text-gray-900 dark:text-white"
                      : "text-gray-600 dark:text-gray-300",
                  ]}
                >
                  {label}
                  {code === lang && (
                    <svg
                      aria-hidden="true"
                      xmlns="http://www.w3.org/2000/svg"
                      class="size-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m4.5 12.75 6 6 9-13.5"
                      />
                    </svg>
                  )}
                </a>
              ))
            }
          </div>
        </details>

        <button
          id="menu-button"
        class="block rounded-sm bg-gray-100 p-2.5 text-gray-600 transition hover:text-gray-600/75 md:hidden dark:bg-[#1a191c] dark:text-gray-300"
      >
        <span class="sr-only">Toggle menu</span>
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          class="size-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- スマホ用メニュー: same as the blog's fullscreen mobile menu (blog.icysamon.com) -->
  <nav
    id="mobile-menu"
    aria-label="Mobile"
    class="fixed inset-0 z-50 hidden overflow-y-auto bg-gray-50/97 px-6 py-20 md:hidden dark:bg-[#1a191c]/99"
  >
    <button
      id="menu-close"
      type="button"
      class="fixed end-8 top-5 z-50 flex size-12 items-center justify-center rounded-full border border-gray-300 bg-gray-50 text-gray-700 transition hover:border-pink-600 hover:text-pink-600 dark:border-[#2f2e32] dark:bg-[#1a191c] dark:text-gray-200 dark:hover:border-pink-400 dark:hover:text-pink-400"
    >
      <span class="sr-only">Close menu</span>
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        class="size-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <ul class="mx-auto max-w-md space-y-6">
      {
        [
          { href: "/about", label: t("nav.about") },
          { href: "/music", label: t("nav.music") },
          { href: "/electronic-work", label: t("nav.electronicWork") },
          { href: "/game", label: t("nav.game") },
        ].map(({ href, label }) => (
          <li class="px-2">
            <a
              href={translatePath(href)}
              class="block text-2xl font-bold tracking-tight text-gray-700 transition hover:text-pink-600 dark:text-gray-200 dark:hover:text-pink-400"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const menu = document.getElementById("mobile-menu");

    if (target.closest("#menu-button")) {
      menu?.classList.remove("hidden");
    } else if (target.closest("#menu-close")) {
      menu?.classList.add("hidden");
    }

    const langMenu = document.getElementById("lang-menu") as HTMLDetailsElement | null;
    if (langMenu?.open && !target.closest("#lang-menu")) {
      langMenu.open = false;
    }
  });
</script>

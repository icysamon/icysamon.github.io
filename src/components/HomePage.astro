---
import electronicWorkImage from "../assets/electronic-work/car.jpg";
import gameImage from "../assets/game/2023/happy-happy-happy.webp";
import newSongImage from "../assets/album-cover/kawaii-squeeze.webp";
import Album from "../components/Album.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LinkCard from "../components/LinkCard.astro";
import ProfileCard from "../components/ProfileCard.astro";
import SocialLinks from "../components/SocialLinks.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Header />
<div
  class="flex flex-col items-center gap-8 mx-auto my-4 w-[90%] max-w-2xl md:flex-row md:items-start md:max-w-6xl"
>
  <div
    class="flex flex-col gap-4 w-full md:sticky md:top-8 md:w-80 md:shrink-0"
  >
    <div
      class="flex flex-col items-center gap-4 w-full pb-8 rounded-md bg-slate-500/5 dark:bg-white/5"
    >
      <ProfileCard />
      <SocialLinks />
    </div>
    <LinkCard />
  </div>

  <div class="flex flex-col gap-8 items-center w-full min-w-0">
    <FeatureCard
      title={t("home.electronicWork.title")}
      description={t("home.electronicWork.description")}
      image={electronicWorkImage.src}
      href={translatePath("/electronic-work")}
    />
    <FeatureCard
      title={t("home.music.title")}
      description={t("release.kawaiiSqueeze.title")}
      image={newSongImage.src}
      href={t("release.kawaiiSqueeze.url")}
    />
    <FeatureCard
      title={t("home.game.title")}
      description={t("home.game.description")}
      image={gameImage.src}
      href={translatePath("/game")}
    />
  </div>
</div>

<div class="mt-auto mx-auto w-full max-w-200 px-4 sm:px-6 lg:px-8">
  <Footer />
</div>

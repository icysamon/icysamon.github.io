---
import electronicWorkImage from "../assets/electronic-work/car.jpg";
import gameImage from "../assets/game/2023/happy-happy-happy.webp";
import newSongImage from "../assets/album-cover/kawaii-squeeze.webp";
import musicImage from "../assets/album-cover/black-cat-and-apprentice-girls.webp";
import Album from "../components/Album.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LinkCard from "../components/LinkCard.astro";
import ProfileCard from "../components/ProfileCard.astro";
import SocialLinks from "../components/SocialLinks.astro";
import StreamingLinkCard from "../components/StreamingLinkCard.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Header />
<main
  class="mx-auto my-4 flex w-[90%] max-w-2xl flex-col items-center gap-4 md:max-w-5xl md:gap-8 md:flex-row md:items-start"
>
  <div
    class="flex w-full flex-col gap-4 md:sticky md:top-8 md:w-80 md:shrink-0"
  >
    <div
      class="flex w-full flex-col items-center gap-4 rounded-md bg-slate-500/5 pb-8 dark:bg-white/5"
    >
      <ProfileCard />
      <SocialLinks />
    </div>
    <LinkCard />
    <StreamingLinkCard />
  </div>

  <div class="flex w-full min-w-0 flex-col items-center gap-4 md:items-start">
    <FeatureCard
      title={t("home.electronicWork.title")}
      description={t("home.electronicWork.description")}
      image={electronicWorkImage.src}
      href={translatePath("/electronic-work")}
    />
    <FeatureCard
      title={t("home.music.title")}
      description={t("release.kawaiiSqueeze.title")}
      image={newSongImage.src}
      href={t("release.kawaiiSqueeze.url")}
    />
    <FeatureCard
      title={t("home.musicWorks.title")}
      description={t("home.musicWorks.description")}
      image={musicImage.src}
      href={translatePath("/music")}
    />
    <FeatureCard
      title={t("home.game.title")}
      description={t("home.game.description")}
      image={gameImage.src}
      href={translatePath("/game")}
    />
  </div>
</main>

<div class="mx-auto mt-auto w-full max-w-200 px-4 sm:px-6 lg:px-8">
  <Footer />
</div>

---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Grid of buttons, one per streaming service: they look the same at rest and take the service's brand color on hover
const links = [
  {
    text: "Apple Music",
    href: "https://music.apple.com/jp/artist/icysamon/1808762015",
    class: "hover:bg-[#fa243c] hover:text-white dark:hover:bg-[#fa243c] dark:hover:text-white",
  },
  {
    text: "Spotify",
    href: "https://open.spotify.com/artist/7tk5ryKLzZdGvABO1H0LCx",
    class: "hover:bg-[#1ed760] hover:text-black dark:hover:bg-[#1ed760] dark:hover:text-black",
  },
  {
    text: "Amazon Music",
    href: "https://www.amazon.co.jp/music/player/artists/B0F47XHZG4",
    class: "hover:bg-[#25d1da] hover:text-black dark:hover:bg-[#25d1da] dark:hover:text-black",
  },
  {
    // TuneCore Japan artist page, which lists every other platform
    text: t("dictionary.otherPlatforms"),
    href: t("link.tunecore"),
    class: "hover:bg-[#111111] hover:text-white dark:hover:bg-[#111111] dark:hover:text-white",
  },
];
---

<ul class="grid w-full grid-cols-2 gap-2">
  {
    links.map(({ text, href, class: color }) => (
      <li>
        <a
          href={href}
          class:list={[
            "flex items-center justify-center rounded-md bg-slate-500/5 px-3 py-3 font-medium whitespace-nowrap text-gray-900 transition-colors dark:bg-white/5 dark:text-gray-50",
            color,
          ]}
        >
          {text}
        </a>
      </li>
    ))
  }
</ul>

---
// Variant of LinkCard: rows look the same at rest and take their streaming service's brand color on hover
const links = [
  {
    text: "Apple Music",
    href: "https://music.apple.com/jp/artist/icysamon/1808762015",
    class: "hover:bg-[#fa243c] hover:text-white dark:hover:bg-[#fa243c] dark:hover:text-white",
  },
  {
    text: "Spotify",
    href: "https://open.spotify.com/artist/7tk5ryKLzZdGvABO1H0LCx",
    class: "hover:bg-[#1ed760] hover:text-black dark:hover:bg-[#1ed760] dark:hover:text-black",
  },
  {
    text: "Amazon Music",
    href: "https://music.amazon.co.jp/artists/B0F47XHZG4/icysamon",
    class: "hover:bg-[#25d1da] hover:text-black dark:hover:bg-[#25d1da] dark:hover:text-black",
  },
];
---

<ul
  class="w-full divide-y divide-gray-200 rounded-md bg-slate-500/5 p-2 dark:divide-white/20 dark:bg-white/5"
>
  {
    links.map(({ text, href, class: color }) => (
      <li>
        <a
          href={href}
          class:list={[
            "group flex items-center justify-between rounded-md px-4 py-3 text-gray-900 transition-colors dark:text-gray-50",
            color,
          ]}
        >
          <span class="font-medium">{text}</span>
          <svg
            viewBox="0 0 13 10"
            class="h-2.5 w-3.5 fill-none stroke-current stroke-2 text-gray-500 transition-transform [stroke-linecap:round] [stroke-linejoin:round] group-hover:translate-x-1 group-hover:text-inherit dark:text-gray-400 dark:group-hover:text-inherit"
          >
            <path d="M1,5 L11,5" />
            <polyline points="8 1 12 5 8 9" />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

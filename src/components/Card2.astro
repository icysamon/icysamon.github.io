---
interface Props {
  title: string;
  description: string;
  date: string;
  url: string;
  image: any;
  imageAlt: string;
}
import { getLangFromUrl } from "../i18n/utils";

const { title, description, date, url, image, imageAlt } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const localeMap = { en: "en-US", ja: "ja-JP" } as const;
const formattedDate = new Date(date).toLocaleDateString(localeMap[lang], {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<article
  class="relative overflow-hidden rounded-lg shadow-sm transition hover:shadow-lg max-w-lg"
>
  <img
    alt={imageAlt}
    src={image}
    class="absolute inset-0 h-full w-full object-cover"
  />

  <div
    class="relative bg-linear-to-t from-gray-900/50 to-gray-900/25 pt-32 sm:pt-48 lg:pt-64"
  >
    <div class="p-4 sm:p-6">
      <time datetime={date} class="block text-xs text-white/90">
        {formattedDate}
      </time>

      <a href={url}>
        <h3 class="mt-0.5 text-lg text-white">
          {title}
        </h3>
      </a>

      <p class="mt-2 line-clamp-3 text-sm/relaxed text-white/95">
        {description}
      </p>
    </div>
  </div>
</article>

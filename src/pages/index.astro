---
import kawaiiSqueeze from "../assets/album-cover/kawaii-squeeze.webp";
import ProfileCard from "../components/ProfileCard.astro";
import Album from "../components/Album.astro";
import IconBar from "../components/IconBar.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="flex flex-col items-center justify-center min-h-screen gap-8">
    <ProfileCard />
    <div class="flex gap-6">
      <Button text="ブログ" href="https://blog.icysamon.com" />
      <Button
        text="音楽配信"
        href="https://www.tunecore.co.jp/artists/icysamon"
      />
    </div>
    <IconBar />
    <h2 class="text-2xl font-bold mt-8 mb-4 text-gray-900 dark:text-gray-300">
      新曲です↓
    </h2>
    <Album
      title="かわいいぎゅっと！"
      subtitle="2026年10月4日"
      image={kawaiiSqueeze.src}
      href="https://linkco.re/CC6eP5GY"
    />
    <Footer />
  </div>
</Layout>
